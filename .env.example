# DS108 API Keys — copy to .env and fill in values
# .env is gitignored and should never be committed

# Claude API — required for 04b LLM extraction
# Official Anthropic key: https://console.anthropic.com/
# OR proxy service key (e.g. https://1gw.gwai.cloud)
ANTHROPIC_API_KEY=sk-ant-...

# API endpoint — change if using a proxy service
# Default (official): https://api.anthropic.com
# Proxy example:      https://1gw.gwai.cloud
ANTHROPIC_BASE_URL=https://api.anthropic.com

# USDA QuickStats — required for corn crop progress data
# Register free at: https://quickstats.nass.usda.gov/api
USDA_NASS_API_KEY=your-usda-key-here
