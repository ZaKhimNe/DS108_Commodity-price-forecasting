# DS108 API Keys — copy to .env and fill in values
# .env is gitignored and should never be committed

# Claude API (Anthropic) — required for 04b LLM extraction
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# USDA QuickStats — required for corn crop progress data
